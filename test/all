#!/usr/bin/env bash
# The plugin's test suite: an isolated state dir and shims for curl and the agents, so the whole
# token/models/pick/launch path runs on any machine with bash 3.2+ and jq. TAP-flavored: first
# failure ends the file. No network, no real agent.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CLI="$ROOT/bin/omarchy-hf-agent"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
export OMARCHY_HF_USER_HOME="$TMP/home" OMARCHY_HF_STATE="$TMP/state" OMARCHY_HF_ROUTER="https://router.test" \
  OMARCHY_HF_FOREGROUND=1 SHIM="$TMP/shim" GOOD=hf_good_token_value \
  PATH="$TMP/bin:/usr/bin:/bin"   # shims plus the base system only; the developer's own agents must not leak in
mkdir -p "$TMP/bin" "$TMP/home" "$SHIM"
ln -s "$(PATH="$PATH:/opt/homebrew/bin:/usr/local/bin" command -v jq)" "$TMP/bin/jq"
n=0
pass() { n=$((n+1)); echo "ok $n - $1"; }
fail() { echo "not ok - $1${2:+: $2}" >&2; exit 1; }
snap() { jq -r "$1" "$OMARCHY_HF_STATE/snapshot.json"; }
mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }   # GNU first; BSD stat has no -c (and GNU stat -f prints instead of failing)
S="$OMARCHY_HF_STATE"

# ---------------------------------------------------------------- shims
cat >"$TMP/bin/curl" <<'EOF2'
#!/usr/bin/env bash
# the router: 200 with a model list for the good token, 401 otherwise; SHIM_DOWN = no network
printf '%s\n' "$*" >>"$SHIM/curl.log"   # this shim's argv is what /proc/<pid>/cmdline would show
url=""; out=""; auth=""
for ((i=1;i<=$#;i++)); do
  a=${!i}; j=$((i+1))
  case $a in
    -o) out=${!j} ;;
    -H) h=${!j}; [[ $h == @* ]] && h=$(cat "${h#@}" 2>/dev/null); [[ $h == "Authorization: Bearer "* ]] && auth=${h#Authorization: Bearer } ;;
    https://*) url=$a ;;
  esac
done
[[ -n ${SHIM_DOWN:-} ]] && { echo "curl: (6) Could not resolve host" >&2; exit 6; }
if [[ $auth != "$GOOD" ]]; then printf '{"error":"Invalid credentials"}' >"$out"; printf 401; exit 0; fi
case $url in
  */v1/models) list='{"data":[{"id":"Qwen/Qwen3-Coder"},{"id":"deepseek-ai/DeepSeek-V3"},{"id":"Qwen/Qwen3-Coder"}]}'
    printf '%s' "${SHIM_MODELS:-$list}" >"$out"; printf '%s' "${SHIM_CODE:-200}" ;;
  *) printf '{}' >"$out"; printf 404 ;;
esac
EOF2
for a in pi codex opencode crush hermes; do printf '#!/usr/bin/env bash\necho "$0 $* HF_TOKEN=${HF_TOKEN:-} OPENAI_API_KEY=${OPENAI_API_KEY:-} OPENAI_BASE_URL=${OPENAI_BASE_URL:-} OPENCODE_CONFIG_CONTENT=${OPENCODE_CONFIG_CONTENT:-} PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR:-} XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-}"\n' >"$TMP/bin/$a"; done
printf '#!/usr/bin/env bash\necho "launch $*"\n' >"$TMP/bin/omarchy-launch-tui"
printf '#!/usr/bin/env bash\necho pi\n' >"$TMP/bin/omarchy-default-agent"
find "$TMP/bin" -type f -exec chmod +x {} +   # not the jq symlink: its target is not ours to chmod on CI

# ---------------------------------------------------------------- fresh state
"$CLI" snapshot >/dev/null
[[ $(snap .token.set) == false && $(snap .model) == "" && $(snap .harness) == "" && $(snap .error) == "" ]] || fail "fresh snapshot" "$(cat "$S/snapshot.json")"; pass "fresh snapshot: no token, no model, no harness, no error"
[[ $(snap '.harnesses.installed|join(",")') == "pi,opencode,codex,hermes,crush" && $(snap .harnesses.default) == pi ]] || fail "harnesses" "$(snap .harnesses)"; pass "installed harnesses are listed in the plugin's order; Omarchy's default is named"
[[ $(snap '.harnesses.installed|index("claude")') == null ]] || fail "claude offered"; pass "claude is never offered: the router has no Messages endpoint"
[[ $(mode "$S") == 700 ]] || fail "state dir mode" "$(ls -ld "$S")"; pass "the state directory is 0700"

# ---------------------------------------------------------------- token
"$CLI" launch >/dev/null 2>&1 && fail "launch without token"
[[ $(snap .error) == *"no token"* ]] || fail "refusal in snapshot" "$(snap .error)"; pass "launch without a token is refused, and the reason is on the card"
"$CLI" token hf_wrong >/dev/null 2>&1 && fail "bad token accepted"
[[ $(snap .error) == *"rejected that token (401)"* && $(snap .token.set) == false && ! -e $S/token ]] || fail "bad token" "$(snap .error)"; pass "token: a 401 refuses in one sentence and nothing is kept"
SHIM_DOWN=1 "$CLI" token "$GOOD" >/dev/null 2>&1 && fail "token accepted offline"
[[ $(snap .error) == *"could not reach"* && ! -e $S/token ]] || fail "offline token" "$(snap .error)"; pass "token: no network is said as such, not as a wrong token"
"$CLI" token "$GOOD" >/dev/null
[[ $(snap .token.set) == true && $(snap .error) == "" && $(cat "$S/token") == "$GOOD" ]] || fail "token set" "$(cat "$S/snapshot.json")"; pass "token: accepted by the router, kept, and the earlier refusal retired"
[[ $(snap .token.file) == "$S/token" && $(snap '.token|has("value")') == false ]] || fail "snapshot names the token file"; pass "the snapshot carries the token file's path, never the token"
for f in token auth snapshot.json log; do m=$(mode "$S/$f"); [[ $m == 600 ]] || fail "mode of $f" "$m"; done; pass "token, auth header file, snapshot, and log are 0600"
grep -q -- "$GOOD" "$SHIM/curl.log" && fail "token in curl argv"; grep -q -- "-H @$S/auth" "$SHIM/curl.log" || fail "header file not used"; pass "the router is called with -H @file: the token is never in curl's argv"
grep -rq -- "$GOOD" "$S/snapshot.json" "$S/log" && fail "token leaked into snapshot or log"; pass "the token is in the token file only: not in the snapshot or the log"
[[ $(snap '.models|join(",")') == "Qwen/Qwen3-Coder,deepseek-ai/DeepSeek-V3" ]] || fail "models cached on token set" "$(snap .models)"; pass "the validating GET doubles as the first model list, deduplicated and sorted"
"$CLI" token hf_typo >/dev/null 2>&1 && fail "typo accepted"
[[ $(cat "$S/token") == "$GOOD" && $(snap .token.set) == true && $(snap .error) == *"401"* ]] || fail "typo kept old token" "$(snap .error)"; pass "token: a rejected replacement leaves the working token in place, with the refusal shown"
"$CLI" token --clear >/dev/null
[[ $(snap .token.set) == false && ! -e $S/token && ! -e $S/auth && $(snap .error) == "" ]] || fail "token clear"; pass "token --clear removes the token and the header file"
"$CLI" models >/dev/null 2>&1 && fail "models without token"
[[ $(snap .error) == *"no token"* ]] || fail "models refusal"; pass "models without a token is refused out loud"
"$CLI" token "$GOOD" >/dev/null

# ---------------------------------------------------------------- models
SHIM_MODELS='{"data":[{"id":"b/two"},{"id":"a/one"}]}' "$CLI" models >/dev/null
[[ $(snap '.models|join(",")') == "a/one,b/two" && $(mode "$S/models.json") == 600 ]] || fail "models refetch" "$(snap .models)"; pass "models: refreshes the cache from /v1/models"
SHIM_DOWN=1 "$CLI" models >/dev/null 2>&1 && fail "models offline"
[[ $(snap .error) == *"could not reach"* && $(snap '.models|join(",")') == "a/one,b/two" ]] || fail "models offline keeps cache" "$(snap .error)"; pass "models: no network keeps the cached list and says why"
SHIM_CODE=500 "$CLI" models >/dev/null 2>&1 && fail "500 accepted"; [[ $(snap .error) == *"answered 500"* ]] || fail "500 message"; pass "models: an unexpected status is reported by number"
"$CLI" models >/dev/null; [[ $(snap .error) == "" ]] || fail "models clears error"; pass "a models refresh that works retires the refusal"

# ---------------------------------------------------------------- picks
"$CLI" model "Qwen/Qwen3-Coder" >/dev/null; [[ $(snap .model) == "Qwen/Qwen3-Coder" ]] || fail "model pick"; pass "model <id> records the pick"
"$CLI" model "org/unlisted-model:fireworks-ai" >/dev/null; [[ $(snap .model) == "org/unlisted-model:fireworks-ai" ]] || fail "unlisted model"; pass "model <id> takes an id the card does not list, with a provider suffix"
"$CLI" model 'x;rm -rf /' >/dev/null 2>&1 && fail "bad id accepted"; [[ $(snap .error) == *"letters, digits"* && $(snap .model) == "org/unlisted-model:fireworks-ai" ]] || fail "bad id" "$(snap .error)"; pass "model refuses an id with shell characters and keeps the old pick"
"$CLI" model --clear >/dev/null; [[ $(snap .model) == "" ]] || fail "model clear"; pass "model --clear forgets the pick"
"$CLI" launch >/dev/null 2>&1 && fail "launch without model"; [[ $(snap .error) == *"no model"* ]] || fail "no model refusal"; pass "launch without a model is refused out loud"
"$CLI" model "Qwen/Qwen3-Coder" >/dev/null
"$CLI" harness nope >/dev/null 2>&1 && fail "unknown harness"; [[ $(snap .error) == *"not an installed harness"* ]] || fail "harness refusal"; pass "harness refuses a name that is not installed"
"$CLI" harness codex >/dev/null; [[ $(snap .harness) == codex && $(snap .error) == "" ]] || fail "harness pick"; pass "harness <name> records the pick"
"$CLI" harness --clear >/dev/null; [[ $(snap .harness) == "" ]] || fail "harness clear"; pass "harness --clear falls back to the default"

# ---------------------------------------------------------------- launch
argv=$("$CLI" launch); [[ $argv == *omarchy-hf-agent-launch* && $argv != *"$GOOD"* ]] || fail "default launch argv" "$argv"; pass "launch with no harness picked uses Omarchy's default; the token is not in argv"
out=$(eval "$argv"); [[ $out == *"/pi --provider hf --model Qwen/Qwen3-Coder"* && $out == *"HF_TOKEN=$GOOD"* && $out == *"PI_CODING_AGENT_DIR=$S/agents/pi"* ]] || fail "pi launch" "$out"; pass "launch pi: provider flags by argv, token by environment, plugin-owned agent dir"
grep -q -- "$GOOD" "$S/agents/pi/models.json" && fail "token in pi models.json"; [[ $(jq -r '.providers.hf.apiKey' "$S/agents/pi/models.json") == HF_TOKEN && $(jq -r '.providers.hf.baseUrl' "$S/agents/pi/models.json") == "https://router.test/v1" ]] || fail "pi models.json"; pass "pi's models.json names the variable and the router, not the token"
argv=$("$CLI" launch codex); out=$(eval "$argv")
[[ $out == *"wire_api=chat"* && $out == *"base_url=https://router.test/v1"* && $out == *"model=Qwen/Qwen3-Coder"* && $out == *"HF_TOKEN=$GOOD"* && $argv != *"$GOOD"* ]] || fail "codex launch" "$out"; pass "launch codex: chat-completions provider by flags, token by environment only"
argv=$("$CLI" launch opencode); out=$(eval "$argv")
[[ $out == *"--model hf/Qwen/Qwen3-Coder"* && $out == *'"apiKey":"{env:HF_TOKEN}"'* && $out == *"HF_TOKEN=$GOOD"* && $argv != *"$GOOD"* ]] || fail "opencode launch" "$out"; pass "launch opencode: config by environment with an {env:} key, token by environment only"
argv=$("$CLI" launch crush); out=$(eval "$argv")
[[ $out == *"XDG_CONFIG_HOME=$S/agents/crush"* && $out == *"HF_TOKEN=$GOOD"* && $argv != *"$GOOD"* ]] || fail "crush launch" "$out"
grep -q -- "$GOOD" "$S/agents/crush/crush/crush.json" && fail "token in crush.json"; [[ $(jq -r '.providers.hf.api_key' "$S/agents/crush/crush/crush.json") == '$HF_TOKEN' ]] || fail "crush api_key"; pass "launch crush: plugin-owned XDG homes, config names \$HF_TOKEN, token by environment only"
argv=$("$CLI" launch hermes); out=$(eval "$argv")
[[ $out == *"OPENAI_BASE_URL=https://router.test/v1"* && $out == *"OPENAI_API_KEY=$GOOD"* && $argv != *"$GOOD"* ]] || fail "hermes launch" "$out"; pass "launch hermes: OPENAI_BASE_URL and OPENAI_API_KEY by convention"
grep -rq -- "$GOOD" "$S/log" "$S/snapshot.json" "$S/agents" && fail "token leaked by a launch"; pass "after five launches the token is still in the token file only"
[[ ! -e $OMARCHY_HF_USER_HOME/.codex && ! -e $OMARCHY_HF_USER_HOME/.config && ! -e $OMARCHY_HF_USER_HOME/.pi ]] || fail "user files touched"; pass "no user config files were created or edited"
"$CLI" launch claude >/dev/null 2>&1 && fail "claude launched"; [[ $(snap .error) == *"not an installed harness"* ]] || fail "claude refusal"; pass "launch claude is refused: not a harness this plugin offers"
"$CLI" launch pi >/dev/null; [[ $(snap .error) == "" ]] || fail "launch clears refusal"; pass "a launch that works retires the earlier refusal"
OMARCHY_HF_FOREGROUND=0 "$CLI" launch pi >/dev/null; sleep 0.3; grep -q "launch pi on Qwen/Qwen3-Coder" "$S/log" || fail "launch logged"; pass "a detached launch goes through omarchy-launch-tui and is logged by name, not by token"
mkdir -p "$TMP/work"; "$CLI" agent-dir "$TMP/work"; [[ $(cat "$S/agent-dir") == "$(cd "$TMP/work" && pwd)" ]] || fail "agent-dir"; pass "agent-dir records where agents open"
"$CLI" agent-dir "$TMP/nope" 2>/dev/null && fail "bad agent-dir"; pass "agent-dir refuses a path that is not a directory"

echo "1..$n"
